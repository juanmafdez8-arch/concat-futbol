// Tagging, the way Nacsport's tagging window works: a button per category,
// pressed as the play happens - or its key, 1 to 9, without looking - to
// cut a register round the playhead, as far back and on as the category
// says; then the descriptors and the stars that qualify the register just
// made. Under them the registers themselves, filtered by category and by
// rating, any one a click away, and the filtered lot a presentation - a
// timeline of their own - in one press. The template is the project's and
// is edited here: categories, their reach either side, descriptors.

import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Button, Field } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";
import { NumberField } from "../primitives/number-field.slint";
import { TagButtonData, TagChipData, TagRowData } from "../timeline/model.slint";
import { Editor } from "../editor.slint";
import { Pane } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";

// A category button: its colour as a band down the left, its name, its key
// and how many registers it has.
component TagButton inherits Rectangle {
    in property <TagButtonData> data;
    callback pressed();

    height: 44px;
    border-radius: Theme.r;
    background: touch.pressed ? data.colour.with-alpha(0.45)
        : touch.has-hover ? data.colour.with-alpha(0.28) : data.colour.with-alpha(0.16);
    border-width: 1px;
    border-color: data.colour.with-alpha(0.7);

    Rectangle {
        x: 0;
        width: 5px;
        height: parent.height;
        border-radius: 2px;
        background: data.colour;
    }

    Text {
        x: 12px;
        y: 5px;
        width: parent.width - 44px;
        text: data.name;
        color: Theme.fg;
        font-size: Theme.fs;
        font-weight: 600;
        overflow: elide;
    }

    Text {
        x: 12px;
        y: parent.height - self.height - 5px;
        text: data.count == 1 ? I18n.t("tag.oneRegister") : I18n.t1("tag.registers", "\{data.count}");
        color: Theme.fg-muted;
        font-size: Theme.fs - 1px;
    }

    if data.key != "": Rectangle {
        x: parent.width - 26px;
        y: 6px;
        width: 20px;
        height: 18px;
        border-radius: 3px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.line;

        Text {
            text: data.key;
            color: Theme.fg;
            font-size: Theme.fs - 1px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pressed(); }
    }
}

// A descriptor: lit when the register in hand carries it.
component TagChip inherits Rectangle {
    in property <TagChipData> data;
    callback toggled();

    height: 26px;
    border-radius: 13px;
    background: data.on ? Theme.accent.with-alpha(0.85) : touch.has-hover ? Theme.field-hover : Theme.field;
    border-width: 1px;
    border-color: data.on ? Theme.accent : Theme.line;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: data.name;
        color: data.on ? #111111 : Theme.fg;
        font-size: Theme.fs - 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component TaggingPane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    /// What the template editor's two fields hold.
    property <string> new-category;
    property <string> new-descriptor;
    /// A verdict's colour: green, amber, red, or grey for not enough seen.
    function verdict-colour(kind: int) -> color {
        if (kind == 1) {
            return #2ecc71;
        }
        if (kind == 2) {
            return #f5c518;
        }
        if (kind == 3) {
            return #e74c3c;
        }
        return #8b949e;
    }

    /// Buttons and chips per row.
    property <int> across: root.width > 520px ? 4 : root.width > 340px ? 3 : 2;

    VerticalLayout {
        // The bar every pane has: the switcher, the name, and the editor's
        // switch on the right.
        Rectangle {
            height: 52px;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        PaneSwitcher {
                            kind: PaneKind.tagging;
                            seat: root.pane-seat;
                            removable: root.pane-removable;
                            picked(kind) => { root.pane-picked(kind); }
                            removed => { root.pane-removed(); }
                        }
                    }

                    Text {
                        text: I18n.t("tag.title");
                        color: Theme.fg;
                        font-size: Theme.fs + 1px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            label: Editor.analysis-workspace ? I18n.t("bar.editWorkspace") : I18n.t("bar.workspaceShort");
                            ghost: true;
                            clicked => { Editor.analysis-workspace-toggled(); }
                        }
                    }
                    VerticalLayout {
                    alignment: center;
                    Button {
                        label: Editor.tag-editing ? I18n.t("tag.done") : I18n.t("tag.editTemplate");
                        ghost: !Editor.tag-editing;
                        primary: Editor.tag-editing;
                        clicked => { Editor.tag-edit(!Editor.tag-editing); }
                    }
                    }
                }
            }
        }

        ScrollView {
            VerticalLayout {
                padding: Theme.pad;
                spacing: 10px;

                // ── the template editor ──
                if Editor.tag-editing: VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: I18n.t("tag.categories");
                        color: Theme.fg-muted;
                        font-size: Theme.fs - 1px;
                    }

                    for button[index] in Editor.tag-buttons: HorizontalLayout {
                        spacing: 6px;
                        height: 28px;

                        Rectangle {
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: button.colour;
                        }

                        Text {
                            text: button.name;
                            color: Theme.fg;
                            font-size: Theme.fs;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: I18n.t("tag.before");
                            color: Theme.fg-muted;
                            font-size: Theme.fs - 1px;
                            vertical-alignment: center;
                        }

                        NumberField {
                            width: 56px;
                            value: button.lead;
                            minimum: 0;
                            maximum: 60;
                            step: 0.5;
                            precision: 1;
                            unit: "s";
                            changed(v) => { Editor.tag-category-time(index, 0, v); }
                        }

                        Text {
                            text: I18n.t("tag.after");
                            color: Theme.fg-muted;
                            font-size: Theme.fs - 1px;
                            vertical-alignment: center;
                        }

                        NumberField {
                            width: 56px;
                            value: button.lag;
                            minimum: 0;
                            maximum: 60;
                            step: 0.5;
                            precision: 1;
                            unit: "s";
                            changed(v) => { Editor.tag-category-time(index, 1, v); }
                        }

                        Button {
                            label: "×";
                            ghost: true;
                            square: true;
                            clicked => { Editor.tag-category-remove(index); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Field {
                            horizontal-stretch: 1;
                            value: root.new-category;
                            placeholder: I18n.t("tag.newCategory");
                            edited(text) => { root.new-category = text; }
                        }

                        Button {
                            label: I18n.t("tag.add");
                            enabled: root.new-category != "";
                            clicked => {
                                Editor.tag-category-add(root.new-category);
                                root.new-category = "";
                            }
                        }
                    }

                    Text {
                        text: I18n.t("tag.descriptors");
                        color: Theme.fg-muted;
                        font-size: Theme.fs - 1px;
                    }

                    for chip[index] in Editor.tag-chips: HorizontalLayout {
                        spacing: 6px;
                        height: 26px;
                        Text {
                            text: chip.name;
                            color: Theme.fg;
                            font-size: Theme.fs;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Button {
                            label: "×";
                            ghost: true;
                            square: true;
                            clicked => { Editor.tag-descriptor-remove(index); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Field {
                            horizontal-stretch: 1;
                            value: root.new-descriptor;
                            placeholder: I18n.t("tag.newDescriptor");
                            edited(text) => { root.new-descriptor = text; }
                        }

                        Button {
                            label: I18n.t("tag.add");
                            enabled: root.new-descriptor != "";
                            clicked => {
                                Editor.tag-descriptor-add(root.new-descriptor);
                                root.new-descriptor = "";
                            }
                        }
                    }
                }

                // ── the buttons ──
                if !Editor.tag-editing: VerticalLayout {
                    spacing: 6px;
                    for row in Math.ceil(Editor.tag-buttons.length / root.across): HorizontalLayout {
                        spacing: 6px;
                        for column in root.across: Rectangle {
                            horizontal-stretch: 1;
                            height: 44px;
                            if row * root.across + column < Editor.tag-buttons.length: TagButton {
                                width: parent.width;
                                data: Editor.tag-buttons[row * root.across + column];
                                pressed => { Editor.tag-press(row * root.across + column); }
                            }
                        }
                    }
                }

                // ── the matrix: a row per category, every register a bar
                // across the timeline, the playhead over them ──
                if !Editor.tag-editing && Editor.tag-buttons.length > 0: Rectangle {
                    height: Editor.tag-buttons.length * 16px + 8px;
                    border-radius: 6px;
                    background: Theme.field;
                    clip: true;

                    property <length> label-w: 92px;
                    property <length> track-w: self.width - self.label-w - 8px;
                    property <float> span: Math.max(1, Editor.duration-seconds);

                    for button[row] in Editor.tag-buttons: Rectangle {
                        x: 0;
                        y: 4px + row * 16px;
                        width: parent.width;
                        height: 16px;
                        background: Math.mod(row, 2) == 0 ? transparent : #ffffff08;

                        Rectangle {
                            x: 6px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: button.colour;
                        }

                        Text {
                            x: 16px;
                            width: 72px;
                            text: button.name;
                            color: Theme.fg-muted;
                            font-size: 10px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // A click on a row's empty stretch sends the playhead there.
                    TouchArea {
                        x: parent.label-w;
                        width: parent.track-w;
                        mouse-cursor: pointer;
                        clicked => {
                            Editor.seek(Math.max(0, self.mouse-x / self.width) * parent.span);
                        }
                    }

                    for bar in Editor.tag-bars: Rectangle {
                        x: parent.label-w + bar.start / parent.span * parent.track-w;
                        y: 6px + bar.row * 16px;
                        width: Math.max(3px, (bar.end - bar.start) / parent.span * parent.track-w);
                        height: 12px;
                        border-radius: 2px;
                        background: bar.colour.with-alpha(bar.current ? 1 : 0.8);
                        border-width: bar.current ? 1px : 0px;
                        border-color: #ffffff;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Editor.tag-select(bar.id); }
                        }
                    }

                    Rectangle {
                        x: parent.label-w + Editor.playhead / parent.span * parent.track-w;
                        y: 0;
                        width: 1px;
                        height: parent.height;
                        background: Theme.playhead;
                    }
                }

                // ── the register in hand: its descriptors and its stars ──
                if !Editor.tag-editing && Editor.tag-chips.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: Editor.tag-current == "" ? I18n.t("tag.noneInHand") : I18n.t1("tag.inHand", Editor.tag-current);
                        color: Theme.fg-muted;
                        font-size: Theme.fs - 1px;
                    }

                    for row in Math.ceil(Editor.tag-chips.length / root.across): HorizontalLayout {
                        spacing: 6px;
                        for column in root.across: Rectangle {
                            horizontal-stretch: 1;
                            height: 26px;
                            if row * root.across + column < Editor.tag-chips.length: TagChip {
                                width: parent.width;
                                data: Editor.tag-chips[row * root.across + column];
                                toggled => { Editor.tag-descriptor(row * root.across + column); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 2px;
                        alignment: start;
                        for star in 5: Text {
                            text: star < Editor.tag-rating ? "★" : "☆";
                            color: star < Editor.tag-rating ? #f5c518 : Theme.fg-muted;
                            font-size: 20px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Editor.tag-rate(star + 1); }
                            }
                        }
                    }
                }

                // ── the evaluation: the game model, the team, the run; and
                // for the register in hand its verdict, its reasons, and the
                // two buttons that keep it as a reference ──
                if !Editor.tag-editing: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: I18n.t("eval.title");
                        color: Theme.fg;
                        font-size: Theme.fs;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Select {
                            horizontal-stretch: 1;
                            options: Editor.eval-profiles;
                            current: Editor.eval-profile;
                            changed(index) => { Editor.eval-profile-pick(index); }
                        }
                        Button {
                            label: I18n.t("eval.library");
                            ghost: true;
                            clicked => { Editor.eval-open-library(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: I18n.t("eval.ourTeam");
                            color: Theme.fg-muted;
                            font-size: Theme.fs - 1px;
                            vertical-alignment: center;
                        }
                        for kit[index] in Editor.pitch-kits: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: kit;
                                border-width: Editor.eval-team == index + 1 ? 3px : 1px;
                                border-color: Editor.eval-team == index + 1 ? Theme.accent : Theme.line;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Editor.eval-team-pick(index + 1); }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        Button {
                            label: I18n.t("eval.run");
                            primary: true;
                            clicked => { Editor.eval-run(); }
                        }
                    }

                    // The reference library on D:.
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: I18n.t("library.title");
                            color: Theme.fg-muted;
                            font-size: Theme.fs - 1px;
                            vertical-alignment: center;
                        }
                        Button {
                            label: I18n.t("library.import");
                            ghost: true;
                            clicked => { Editor.library-import(); }
                        }
                        Button {
                            label: I18n.t("library.analyse");
                            ghost: true;
                            clicked => { Editor.library-analyse(); }
                        }
                        Button {
                            label: I18n.t("library.learn");
                            ghost: true;
                            clicked => { Editor.library-learn(); }
                        }
                    }

                    Button {
                        label: I18n.t("report.build");
                        clicked => { Editor.report-build(); }
                    }

                    if Editor.eval-kind > 0: VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Rectangle {
                                height: 22px;
                                width: verdict.preferred-width + 18px;
                                border-radius: 11px;
                                background: root.verdict-colour(Editor.eval-kind).with-alpha(0.18);
                                border-width: 1px;
                                border-color: root.verdict-colour(Editor.eval-kind);
                                verdict := Text {
                                    text: Editor.eval-verdict;
                                    color: root.verdict-colour(Editor.eval-kind);
                                    font-size: Theme.fs - 1px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: Editor.eval-refs;
                                color: Theme.fg-muted;
                                font-size: Theme.fs - 2px;
                                vertical-alignment: center;
                            }
                        }
                        for reason in Editor.eval-reasons: Text {
                            text: "• " + reason;
                            color: Theme.fg;
                            font-size: Theme.fs - 1px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                label: I18n.t("eval.refGood");
                                ghost: true;
                                clicked => { Editor.eval-reference(true); }
                            }
                            Button {
                                label: I18n.t("eval.refBad");
                                ghost: true;
                                clicked => { Editor.eval-reference(false); }
                            }
                            Button {
                                label: I18n.t("eval.tune");
                                ghost: true;
                                clicked => { Editor.eval-tune(); }
                            }
                        }
                    }
                }

                // ── the registers ──
                if !Editor.tag-editing: HorizontalLayout {
                    spacing: 6px;
                    Select {
                        horizontal-stretch: 1;
                        options: Editor.tag-filter-options;
                        current: Editor.tag-filter + 1;
                        changed(index) => { Editor.tag-filter-category(index - 1); }
                    }

                    Select {
                        width: 92px;
                        options: ["☆", "★1+", "★2+", "★3+", "★4+", "★5"];
                        current: Editor.tag-min-rating;
                        changed(index) => { Editor.tag-filter-rating(index); }
                    }
                }

                if !Editor.tag-editing: VerticalLayout {
                    spacing: 2px;
                    for register in Editor.tag-rows: Rectangle {
                        height: 30px;
                        border-radius: 3px;
                        background: register.current ? Theme.accent.with-alpha(0.18)
                            : row-touch.has-hover ? Theme.field : transparent;

                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Editor.tag-select(register.id); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 2px;
                            spacing: 8px;

                            Rectangle {
                                width: 4px;
                                background: register.colour;
                            }

                            Text {
                                text: register.time;
                                color: Theme.fg-muted;
                                font-size: Theme.fs - 1px;
                                vertical-alignment: center;
                                width: 40px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: register.name;
                                    color: Theme.fg;
                                    font-size: Theme.fs;
                                    overflow: elide;
                                }

                                if register.descriptors != "": Text {
                                    text: register.descriptors;
                                    color: Theme.fg-muted;
                                    font-size: Theme.fs - 2px;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: register.rating > 0 ? "★\{register.rating}" : "";
                                color: #f5c518;
                                font-size: Theme.fs - 1px;
                                vertical-alignment: center;
                            }

                            Button {
                                label: "×";
                                ghost: true;
                                square: true;
                                clicked => { Editor.tag-delete(register.id); }
                            }
                        }
                    }

                    if Editor.tag-rows.length == 0: Text {
                        text: I18n.t("tag.empty");
                        color: Theme.fg-muted;
                        font-size: Theme.fs - 1px;
                        wrap: word-wrap;
                    }
                }

                if !Editor.tag-editing: HorizontalLayout {
                    spacing: 6px;
                    Button {
                        horizontal-stretch: 1;
                        label: I18n.t("tag.exportXml");
                        enabled: Editor.tag-rows.length > 0;
                        clicked => { Editor.tag-export(true); }
                    }

                    Button {
                        horizontal-stretch: 1;
                        label: I18n.t("tag.exportCsv");
                        enabled: Editor.tag-rows.length > 0;
                        clicked => { Editor.tag-export(false); }
                    }

                    Button {
                        horizontal-stretch: 1;
                        label: I18n.t("tag.importXml");
                        clicked => { Editor.tag-import(); }
                    }
                }

                if !Editor.tag-editing: Button {
                    label: I18n.t1("tag.present", "\{Editor.tag-rows.length}");
                    primary: true;
                    block: true;
                    enabled: Editor.tag-rows.length > 0;
                    clicked => { Editor.tag-present(); }
                }
            }
        }
    }
}
